# RESEND_API_KEY: Required for sending contact form emails via Resend.
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_API_KEY"

# CONTACT_RECIPIENT: Email address that receives contact form submissions.
CONTACT_RECIPIENT="projects@pixtronsystems.com"

# CONTACT_FROM: Sender address for contact emails.
# Use your verified domain, or "onboarding@resend.dev" for testing.
CONTACT_FROM="Pixtron Contact <onboarding@resend.dev>"

# API_PORT: Port for the Express API server (default 3001).
API_PORT=3001
